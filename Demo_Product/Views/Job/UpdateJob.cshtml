@model EntityLayer.Concrete.Job
@{
    ViewData["Title"] = "UpdateJob";
    Layout = "~/Views/Shared/UILayout.cshtml";
}

<form method="post">
    @Html.Label("Meslek ID")
    @Html.TextBoxFor(X => X.JobID, new { @class = "form-control" })
    <br />
    @Html.Label("Meslek Adı")
    @Html.TextBoxFor(X => X.Name, new { @class = "form-control" })
    <br />
    <button class="btn btn-info">Mesleği Güncelle</button>
</form>

